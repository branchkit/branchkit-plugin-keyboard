{
  "id": "keyboard",
  "name": "Keyboard",
  "capabilities": ["input"],
  "version": "1.0.0",
  "description": "Global hotkey capture and keybind registry.",
  "author": "BranchKit",
  "provides": {
    "stores": ["keybinds", "key_names", "layout_characters"],
    "store_schemas": {
      "keybinds": { "merge": "keyed", "content_type": "keybind_registry" },
      "key_names": { "merge": "authoritative", "content_type": "key_names" },
      "layout_characters": { "merge": "authoritative" }
    }
  },
  "run": "./keybind-plugin",
  "hooks": {
    "settings_tabs": [{"label": "Keybinds", "key": "keybinds"}, {"label": "Keys", "key": "keys"}],
    "render_settings": true,
    "on_store_updated": true
  }
}
