{
  "id": "keyboard",
  "name": "Keyboard",
  "capabilities": ["input"],
  "version": "1.0.0",
  "description": "Global hotkey capture and keybind registry.",
  "author": "BranchKit",
  "provides": {
    "stores": ["keybinds", "key_names", "layout_characters"],
    "store_schemas": {
      "keybinds": { "merge": "keyed" },
      "key_names": { "merge": "authoritative" },
      "layout_characters": { "merge": "authoritative" }
    }
  },
  "run": "./keybind-plugin",
  "consumes": {
    "events": [
      {"pattern": "_platform.store.updated"},
      {"pattern": "_platform.keyboard.layout_changed"}
    ]
  },
  "implements": {
    "settings_tabs": [{"label": "Keybinds", "key": "keybinds"}, {"label": "Keys", "key": "keys"}],
    "render_settings": true
  }
}
