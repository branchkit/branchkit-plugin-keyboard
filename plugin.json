{
  "$schema": "https://branchkit.dev/schemas/manifest.json",
  "id": "keyboard",
  "name": "Keyboard & Mouse",
  "icon": "keyboard",
  "requires": {
    "privileges": ["input"],
    "capabilities": {
      "uses": [
        "native.key_repeat_delay",
        "native.key_repeat_rate",
        "native.keyboard_layout",
        "native.warp_cursor"
      ]
    }
  },
  "version": "1.0.0",
  "min_api_version": "0.2.0",
  "description": "Presses keys, clicks and scrolls for you, and names every key.",
  "author": "BranchKit",
  "publisher": "github:branchkit",
  "action_prefix": "input",
  "action_types": {
    "type": {
      "label": "Type Text",
      "fields": [
        { "key": "text", "label": "Text", "field_type": "string", "required": true }
      ]
    },
    "key_by_name": {
      "label": "Press Key",
      "modes": ["hold", "repeat"],
      "fields": [
        { "key": "name", "label": "Key Name", "placeholder": "return", "field_type": "string", "required": true },
        { "key": "modifiers", "label": "Modifiers", "field_type": "string[]", "required": false },
        { "key": "strategy", "label": "Strategy", "placeholder": "key_event", "field_type": "enum", "enum_values": ["key_event", "text"], "required": false }
      ]
    },
    "key": {
      "label": "Press Key (Raw Keycode)",
      "modes": ["hold", "repeat"],
      "fields": [
        { "key": "code", "label": "Keycode", "field_type": "int", "required": true }
      ]
    },
    "shortcut_by_name": {
      "label": "Keyboard Shortcut",
      "modes": ["hold", "repeat"],
      "fields": [
        { "key": "name", "label": "Key Name", "placeholder": "s", "field_type": "string", "required": true },
        { "key": "modifiers", "label": "Modifiers", "placeholder": "cmd", "field_type": "string[]", "required": true },
        { "key": "strategy", "label": "Strategy", "placeholder": "key_event", "field_type": "enum", "enum_values": ["key_event", "text"], "required": false }
      ]
    },
    "shortcut": {
      "label": "Keyboard Shortcut (Raw Keycode)",
      "modes": ["hold", "repeat"],
      "fields": [
        { "key": "code", "label": "Keycode", "field_type": "int", "required": true },
        { "key": "modifiers", "label": "Modifiers", "field_type": "string[]", "required": true }
      ]
    },
    "raw_key": {
      "label": "Raw Key Event",
      "modes": ["hold", "repeat"],
      "fields": [
        { "key": "code", "label": "Keycode", "field_type": "int", "required": true },
        { "key": "direction", "label": "Direction", "placeholder": "click", "field_type": "enum", "enum_values": ["click", "press", "release"], "required": false },
        { "key": "down", "label": "Down (bool shortcut for direction)", "field_type": "boolean", "required": false }
      ]
    },
    "click": {
      "label": "Mouse Click",
      "fields": [
        { "key": "button", "label": "Button", "placeholder": "left", "field_type": "enum", "enum_values": ["left", "right", "middle"], "required": false }
      ]
    },
    "scroll": {
      "label": "Scroll",
      "consequence": "reversible",
      "fields": [
        { "key": "direction", "label": "Direction", "field_type": "enum", "enum_values": ["up", "down", "left", "right"], "required": true },
        { "key": "unit", "label": "Unit", "field_type": "enum", "enum_values": ["line", "pixel"], "required": false },
        { "key": "amount", "label": "Amount", "field_type": "int", "required": false }
      ]
    },
    "move": { "uses": ["native.warp_cursor"],
      "label": "Move Cursor",
      "consequence": "reversible",
      "fields": [
        { "key": "x", "label": "X", "field_type": "int", "required": true },
        { "key": "y", "label": "Y", "field_type": "int", "required": true }
      ]
    },
    "mouse_down": {
      "label": "Mouse Button Down",
      "fields": [
        { "key": "button", "label": "Button", "placeholder": "left", "field_type": "enum", "enum_values": ["left", "right", "middle"], "required": false }
      ]
    },
    "mouse_up": {
      "label": "Mouse Button Up",
      "fields": [
        { "key": "button", "label": "Button", "placeholder": "left", "field_type": "enum", "enum_values": ["left", "right", "middle"], "required": false }
      ]
    },
    "clipboard": {
      "label": "Clipboard",
      "fields": [
        { "key": "action", "label": "Action", "placeholder": "copy", "field_type": "enum", "enum_values": ["copy", "paste", "set"], "required": true },
        { "key": "text", "label": "Text", "field_type": "string", "required": false }
      ]
    }
  },
  "provides": {
    "collections": {
      "plugin.keyboard.overrides": {
        "preset": "data",
        "cardinality": "singleton",
        "id_strategy": { "type": "singleton" },
        "writers": "introducer_only",
        "description": "Legacy store of the user's keybind edits from before Settings → Keybinds; read only to say whether any were left behind."
      },
      "layout_characters": {
        "preset": "data",
        "merge": "authoritative",
        "cardinality": "singleton",
        "id_strategy": { "type": "singleton" },
        "storage": { "type": "memory_only" },
        "writers": "introducer_only",
        "description": "Typeable characters for the active keyboard layout."
      },
      "keys": {
        "id_strategy": { "type": "by_field", "field": "spoken" },
        "preset": "named_entities",
        "fields": [
          {
            "key": "spoken",
            "field_type": "string",
            "label": "Spoken name",
            "required": true
          },
          {
            "key": "key",
            "field_type": "string",
            "label": "Key name",
            "required": true
          }
        ],
        "feeds_matching": {
          "type": "as_named_entities",
          "key_field": "spoken",
          "value_field": "key"
        },
        "description": "Spoken key names for voice command matching."
      },
      "modifiers": {
        "id_strategy": { "type": "by_field", "field": "spoken" },
        "preset": "named_entities",
        "fields": [
          {
            "key": "spoken",
            "field_type": "string",
            "label": "Spoken name",
            "required": true
          },
          {
            "key": "key",
            "field_type": "string",
            "label": "Modifier key",
            "required": true
          }
        ],
        "feeds_matching": {
          "type": "as_named_entities",
          "key_field": "spoken",
          "value_field": "key"
        },
        "description": "Spoken modifier key names (cmd, shift, option, ctrl)."
      }
    }
  },
  "dev": {
    "build": [
      ["templ", "generate"],
      ["go", "build", "-ldflags=-s -w", "-o", "../keyboard-plugin", "."]
    ],
    "build_dir": "src"
  },
  "run": "./keyboard-plugin",
  "consumes": {
    "collections": [{ "name": "_platform.key_names", "fields": ["name", "code"] }],
    "events": [
      {"pattern": "_platform.collection.updated"},
      {"pattern": "_platform.keyboard.layout_changed"}
    ]
  },
  "implements": {
    "settings_tabs": [{"label": "Keys", "key": "keys"}],
    "render_settings": true,
    "on_action": true
  }
}
