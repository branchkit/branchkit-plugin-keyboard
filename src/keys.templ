package main

import "fmt"

templ KeysSettings(data keysTemplateData) {
	<bk-table columns="1fr 1fr 80px">
		<div class="keys-summary">
			<span class="keys-summary-text">{ fmt.Sprintf("%d", data.Count) } key names · Layout: { data.LayoutName }</span>
		</div>
		if data.Error != "" {
			<div class="keys-error">
				{ data.Error }
			</div>
		}
		<div class="table-header">
			<div>Key Name</div>
			<div>Your Keyboard</div>
			<div>Keycode</div>
		</div>
		for _, k := range data.Keys {
			<div class="settings-row">
				<div class="label">
					<span class="keys-name">{ k.Name }</span>
				</div>
				<div class="keys-character">{ k.Character }</div>
				<div class="keys-keycode">{ fmt.Sprintf("%d", k.Keycode) }</div>
			</div>
		}
	</bk-table>
}
